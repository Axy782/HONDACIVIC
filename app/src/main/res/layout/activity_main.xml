<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ============ PANTALLA: REPRODUCIENDO (carátula a pantalla completa) ============ -->
    <FrameLayout
        android:id="@+id/paneReproduciendo"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Carátula ocupando TODA la pantalla -->
        <!-- Fondo: misma carátula borrosa y oscurecida -->
        <ImageView
            android:id="@+id/artBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/bg"/>
        <View
            android:id="@+id/artScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#40000000"/>

        <com.euroaluminio.reproductor.VisualizerView
            android:id="@+id/vizBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <!-- Carátula COMPLETA centrada (sin recortar) -->
        <ImageView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:paddingTop="6dp"
            android:paddingBottom="14dp"
            android:src="@android:color/transparent"/>

        <com.euroaluminio.reproductor.DiscoView
            android:id="@+id/discoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

        <!-- Disco girando: ImageView + animacion (metodo confiable en Android viejo) -->
        <ImageView
            android:id="@+id/discoImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone"/>

        <com.euroaluminio.reproductor.EqNombreView
            android:id="@+id/eqNombre"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

        <!-- Nombre grande cuando NO hay carátula (fondo negro) -->
        <TextView
            android:id="@+id/txtNombreGrande"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="30sp"
            android:maxLines="5"
            android:ellipsize="end"
            android:visibility="gone"/>

        <com.euroaluminio.reproductor.ParticlesView
            android:id="@+id/particulas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

        <!-- Efecto Letras (karaoke) -->
        <View
            android:id="@+id/letrasDim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/letrasTexto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="38sp"
            android:maxLines="4"
            android:ellipsize="end"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/letrasAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center"
            android:layout_marginBottom="60dp"
            android:gravity="center"
            android:textColor="#FFC107"
            android:textStyle="bold"
            android:textSize="14sp"
            android:visibility="gone"/>
        <LinearLayout
            android:id="@+id/letraCtrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <Button android:id="@+id/btnLetraMenos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="− 0.5s" android:textColor="#FFFFFF" android:textSize="14sp" android:background="#99000000"/>
            <TextView android:id="@+id/letraOff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0s" android:textColor="#FFC107" android:textStyle="bold" android:textSize="14sp" android:paddingLeft="14dp" android:paddingRight="14dp"/>
            <Button android:id="@+id/btnLetraMas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+ 0.5s" android:textColor="#FFFFFF" android:textSize="14sp" android:background="#99000000"/>
        </LinearLayout>

        <!-- Botones de arriba -->
        <Button
            android:id="@+id/btnAjustes"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="top|left"
            android:layout_margin="12dp"
            android:text="Ajustes"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="#77000000"/>
        <Button
            android:id="@+id/btnVis"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="top|left"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="62dp"
            android:text="◉ Vista"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="#77000000"/>
        <Button
            android:id="@+id/btnAbrirLista"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="top|right"
            android:layout_margin="12dp"
            android:text="Canciones"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="#77000000"/>

        </FrameLayout>

        <!-- Panel de abajo estilo Poweramp: controles a la izquierda, info a la derecha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#33000000"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- IZQUIERDA: controles (iconos blancos) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <Button android:id="@+id/btnShuffle" android:layout_width="wrap_content" android:layout_height="38dp"
                        android:text="Aleat." android:textSize="10sp" android:textColor="#FFFFFF" android:background="@android:color/transparent"/>
                    <ImageButton android:id="@+id/btnPrev" android:layout_width="48dp" android:layout_height="48dp"
                        android:src="@drawable/ic_jfv_prev" android:scaleType="fitCenter" android:padding="10dp" android:background="@android:color/transparent"/>
                    <ImageButton android:id="@+id/btnPlay" android:layout_width="56dp" android:layout_height="56dp"
                        android:src="@drawable/ic_jfv_play" android:scaleType="fitCenter" android:padding="12dp" android:background="@drawable/circulo_vidrio"/>
                    <ImageButton android:id="@+id/btnNext" android:layout_width="48dp" android:layout_height="48dp"
                        android:src="@drawable/ic_jfv_next" android:scaleType="fitCenter" android:padding="10dp" android:background="@android:color/transparent"/>
                    <Button android:id="@+id/btnRepeat" android:layout_width="wrap_content" android:layout_height="38dp"
                        android:text="Repetir" android:textSize="10sp" android:textColor="#FFFFFF" android:background="@android:color/transparent"/>
                </LinearLayout>

                <!-- DERECHA: info + acciones -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="Sonido JFV" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                                android:singleLine="true" android:ellipsize="end"
                                android:shadowColor="#000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="6"/>
                            <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="Desliza para cambiar canción" android:textColor="#E0E0E8" android:textSize="12sp"
                                android:singleLine="true" android:ellipsize="end"
                                android:shadowColor="#000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="6"/>
                        </LinearLayout>
                        <Button android:id="@+id/btnFav" android:layout_width="42dp" android:layout_height="42dp"
                            android:text="★" android:textSize="16sp" android:textColor="#FFFFFF" android:background="#33FFFFFF"/>
                        <Button android:id="@+id/btnMasLista" android:layout_width="wrap_content" android:layout_height="42dp"
                            android:text="+ Lista" android:textStyle="bold" android:textColor="#FFFFFF" android:background="#33FFFFFF" android:layout_marginLeft="6dp" android:textSize="12sp"/>
                        <Button android:id="@+id/btnEq" android:layout_width="wrap_content" android:layout_height="42dp"
                            android:text="EQ" android:textColor="#FFFFFF" android:textStyle="bold" android:background="#33FFFFFF" android:layout_marginLeft="6dp" android:textSize="12sp"/>
                        <Button android:id="@+id/btnBorrarActual" android:layout_width="wrap_content" android:layout_height="42dp"
                            android:text="Borrar" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="#33FFFFFF" android:layout_marginLeft="6dp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
                        <TextView android:id="@+id/tCur" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0:00" android:textColor="#E0E0E8" android:textSize="10sp"/>
                        <SeekBar android:id="@+id/seek" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="6dp" android:layout_marginRight="6dp"/>
                        <TextView android:id="@+id/tDur" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0:00" android:textColor="#E0E0E8" android:textSize="10sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ============ PANTALLA: LISTA DE CANCIONES ============ -->
    <LinearLayout
        android:id="@+id/paneLista"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">
            <Button android:id="@+id/btnVolver" android:layout_width="wrap_content" android:layout_height="46dp"
                android:text="&#8249; Men&#250; principal" android:textColor="@color/accent" android:textStyle="bold" android:textSize="14sp"
                android:background="@drawable/card_boton" android:paddingLeft="16dp" android:paddingRight="16dp"/>
            <TextView android:id="@+id/count" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginLeft="12dp" android:text="Buscando música…"
                android:textColor="@color/muted" android:textSize="14sp"/>
            <Button android:id="@+id/btnReproCarpeta" android:layout_width="wrap_content" android:layout_height="46dp"
                android:text="Reproducir" android:textColor="@color/accent" android:textStyle="bold" android:textSize="13sp"
                android:background="@color/surface" android:visibility="gone"/>
            <Button android:id="@+id/btnAleatCarpeta" android:layout_width="wrap_content" android:layout_height="46dp"
                android:text="Aleatorio" android:textColor="@color/accent" android:textStyle="bold" android:textSize="13sp"
                android:background="@color/surface" android:layout_marginLeft="6dp" android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp">
            <EditText android:id="@+id/etBuscar" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:hint="Buscar cancion..." android:textColorHint="@color/muted"
                android:textColor="@color/text" android:textSize="16sp" android:singleLine="true"
                android:background="@color/surface2" android:paddingLeft="14dp" android:paddingRight="14dp"
                android:inputType="text" android:imeOptions="actionSearch"/>
            <Button android:id="@+id/btnVozBuscar" android:layout_width="wrap_content" android:layout_height="48dp"
                android:text="Voz" android:textColor="@color/accent" android:textStyle="bold" android:textSize="14sp" android:background="@color/surface2"
                android:layout_marginLeft="6dp" android:paddingLeft="14dp" android:paddingRight="14dp"/>
            <Button android:id="@+id/btnLimpiarBuscar" android:layout_width="wrap_content" android:layout_height="48dp"
                android:text="Limpiar" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" android:background="@color/surface"
                android:layout_marginLeft="6dp" android:paddingLeft="14dp" android:paddingRight="14dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/tabsRow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingBottom="8dp">
            <Button android:id="@+id/tabCarpetas" android:layout_width="0dp" android:layout_height="46dp"
                android:layout_weight="1" android:text="Carpetas" android:textStyle="bold" android:textColor="@color/accent" android:background="@color/surface2"/>
            <Button android:id="@+id/tabListas" android:layout_width="0dp" android:layout_height="46dp"
                android:layout_weight="1" android:layout_marginLeft="8dp" android:text="Mis Listas" android:textStyle="bold" android:textColor="@color/muted" android:background="@color/surface"/>
            <Button android:id="@+id/tabVideos" android:layout_width="0dp" android:layout_height="46dp"
                android:layout_weight="1" android:layout_marginLeft="8dp" android:text="Videos" android:textStyle="bold" android:textColor="@color/muted" android:background="@color/surface"/>
        </LinearLayout>

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:cacheColorHint="#00000000"
            android:divider="#18FFFFFF"
            android:dividerHeight="1dp"/>
    </LinearLayout>

    <!-- ============ PANTALLA: AJUSTES ============ -->
    <LinearLayout
        android:id="@+id/paneAjustes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg"
        android:visibility="gone">

        <!-- Barra superior -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="#12121A" android:padding="12dp">
            <Button android:id="@+id/btnCerrarAjustes" android:layout_width="wrap_content" android:layout_height="44dp"
                android:text="&#8592; Reproduciendo" android:textColor="@color/text" android:textSize="14sp"
                android:background="@drawable/card_boton" android:paddingLeft="16dp" android:paddingRight="16dp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginLeft="14dp" android:text="Configuraci&#243;n" android:textColor="@color/text" android:textSize="19sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="v188" android:textColor="@color/muted" android:textSize="13sp"/>
        </LinearLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:padding="14dp" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <!-- ===== TARJETA: MUSICA ===== -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="M&#218;SICA" android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold"
                    android:letterSpacing="0.1" android:paddingLeft="4dp" android:paddingBottom="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/card_ajuste" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Vincular carpeta de m&#250;sica" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Elige la carpeta del USB donde est&#225; tu m&#250;sica. Solo mostrar&#225; esa carpeta." android:textColor="@color/muted" android:textSize="13sp" android:paddingTop="3dp"/>
                    <Button android:id="@+id/btnVincular" android:layout_width="wrap_content" android:layout_height="48dp"
                        android:text="Elegir carpeta" android:textColor="@color/accent" android:textStyle="bold" android:background="@drawable/card_boton_accent" android:paddingLeft="20dp" android:paddingRight="20dp" android:layout_marginTop="10dp"/>
                    <TextView android:id="@+id/txtCarpetaVinc" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="" android:textColor="@color/accent" android:textSize="12sp" android:paddingTop="6dp"/>
                    <Button android:id="@+id/btnDesvincular" android:layout_width="wrap_content" android:layout_height="42dp"
                        android:text="Ver toda la m&#250;sica otra vez" android:textColor="@color/muted" android:textSize="12sp" android:background="@android:color/transparent" android:visibility="gone"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginTop="14dp" android:layout_marginBottom="14dp"/>
                    <Button android:id="@+id/btnDetectarUsb" android:layout_width="match_parent" android:layout_height="52dp"
                        android:text="Detectar m&#250;sica del USB" android:textColor="@color/accent" android:textStyle="bold" android:background="@drawable/card_boton_accent"/>
                    <TextView android:id="@+id/txtDetectUsb" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="" android:textColor="@color/muted" android:textSize="12sp" android:gravity="center" android:paddingTop="8dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginTop="14dp" android:layout_marginBottom="12dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ordenar canciones" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                        <Button android:id="@+id/ordNombre" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Nombre" android:textSize="13sp" android:textColor="@color/text" android:background="@drawable/card_boton" android:paddingLeft="16dp" android:paddingRight="16dp"/>
                        <Button android:id="@+id/ordArtista" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Artista" android:textSize="13sp" android:textColor="@color/text" android:background="@drawable/card_boton" android:paddingLeft="16dp" android:paddingRight="16dp" android:layout_marginLeft="8dp"/>
                        <Button android:id="@+id/ordFecha" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Fecha" android:textSize="13sp" android:textColor="@color/text" android:background="@drawable/card_boton" android:paddingLeft="16dp" android:paddingRight="16dp" android:layout_marginLeft="8dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== TARJETA: CARATULAS ===== -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CAR&#193;TULAS" android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold"
                    android:letterSpacing="0.1" android:paddingLeft="4dp" android:paddingTop="18dp" android:paddingBottom="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/card_ajuste" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Descargar car&#225;tula al agregar" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Busca la portada en internet." android:textColor="@color/muted" android:textSize="13sp"/>
                        </LinearLayout>
                        <CheckBox android:id="@+id/chkAuto" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Grabar car&#225;tula dentro del MP3" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="La guarda en el archivo, en su carpeta." android:textColor="@color/muted" android:textSize="13sp"/>
                        </LinearLayout>
                        <CheckBox android:id="@+id/chkEmbed" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Calidad de la car&#225;tula" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                        <Button android:id="@+id/calNormal" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Normal" android:textSize="13sp" android:textColor="@color/text" android:background="@drawable/card_boton" android:paddingLeft="14dp" android:paddingRight="14dp"/>
                        <Button android:id="@+id/calAlta" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Alta" android:textSize="13sp" android:textColor="@color/text" android:background="@drawable/card_boton" android:paddingLeft="14dp" android:paddingRight="14dp" android:layout_marginLeft="8dp"/>
                        <Button android:id="@+id/calMaxima" android:layout_width="wrap_content" android:layout_height="44dp" android:text="M&#225;xima" android:textSize="13sp" android:textColor="@color/text" android:background="@drawable/card_boton" android:paddingLeft="14dp" android:paddingRight="14dp" android:layout_marginLeft="8dp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginTop="14dp" android:layout_marginBottom="12dp"/>
                    <Button android:id="@+id/btnDescargarArt" android:layout_width="match_parent" android:layout_height="52dp"
                        android:text="Descargar car&#225;tulas faltantes" android:textColor="@color/accent" android:textStyle="bold" android:background="@drawable/card_boton_accent"/>
                    <TextView android:id="@+id/txtProgArt" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="" android:textColor="@color/muted" android:textSize="12sp" android:gravity="center" android:paddingTop="8dp"/>
                    <TextView android:id="@+id/txtNet" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="" android:textColor="@color/muted" android:textSize="12sp" android:gravity="center" android:paddingTop="4dp"/>
                </LinearLayout>

                <!-- ===== TARJETA: APARIENCIA ===== -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="APARIENCIA" android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold"
                    android:letterSpacing="0.1" android:paddingLeft="4dp" android:paddingTop="18dp" android:paddingBottom="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/card_ajuste" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tema de color" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                        <Button android:id="@+id/temaAmbar" android:layout_width="48dp" android:layout_height="48dp" android:text=" " android:background="#FFB020"/>
                        <Button android:id="@+id/temaAzul" android:layout_width="48dp" android:layout_height="48dp" android:text=" " android:background="#3B82F6" android:layout_marginLeft="10dp"/>
                        <Button android:id="@+id/temaRojo" android:layout_width="48dp" android:layout_height="48dp" android:text=" " android:background="#EF4444" android:layout_marginLeft="10dp"/>
                        <Button android:id="@+id/temaVerde" android:layout_width="48dp" android:layout_height="48dp" android:text=" " android:background="#22C55E" android:layout_marginLeft="10dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== TARJETA: REPRODUCCION ===== -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="REPRODUCCI&#211;N" android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold"
                    android:letterSpacing="0.1" android:paddingLeft="4dp" android:paddingTop="18dp" android:paddingBottom="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/card_ajuste" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Reanudar &#250;ltima canci&#243;n" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold"/>
                        <CheckBox android:id="@+id/chkResume" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Auto-reproducir al abrir" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold"/>
                        <CheckBox android:id="@+id/chkAutoplay" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pausar al desconectar el USB" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold"/>
                        <CheckBox android:id="@+id/chkPausaUsb" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Auto-detectar m&#250;sica (USB nuevo)" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold"/>
                        <CheckBox android:id="@+id/chkAutoDetectar" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Seguir sonando con pantalla apagada" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold"/>
                        <CheckBox android:id="@+id/chkPantalla" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Volumen al arrancar (50%)" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold"/>
                        <CheckBox android:id="@+id/chkVolArranque" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== TARJETA: EXTRAS ===== -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="EXTRAS" android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold"
                    android:letterSpacing="0.1" android:paddingLeft="4dp" android:paddingTop="18dp" android:paddingBottom="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/card_ajuste" android:padding="16dp">
                    <Button android:id="@+id/btnWifi" android:layout_width="match_parent" android:layout_height="52dp"
                        android:text="Recibir archivos por WiFi" android:textColor="@color/accent" android:textStyle="bold" android:background="@drawable/card_boton_accent"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Abre una p&#225;gina para enviar m&#250;sica, videos o APK desde el celular al USB." android:textColor="@color/muted" android:textSize="12sp" android:paddingTop="6dp" android:paddingBottom="14dp"/>
                    <Button android:id="@+id/btnYouTube" android:layout_width="match_parent" android:layout_height="52dp"
                        android:text="Abrir YouTube" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/card_boton_yt"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Abre m.youtube.com en el navegador del radio." android:textColor="@color/muted" android:textSize="12sp" android:paddingTop="6dp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="20dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ============ PANTALLA: EXPLORAR CARPETAS ============ -->
    <LinearLayout
        android:id="@+id/paneExplorar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp">
            <Button android:id="@+id/btnCancelarExplorar" android:layout_width="wrap_content" android:layout_height="46dp"
                android:text="Cancelar" android:textColor="@color/text" android:textSize="14sp" android:background="@color/surface"/>
            <Button android:id="@+id/btnUsarCarpeta" android:layout_width="wrap_content" android:layout_height="46dp"
                android:text="Usar esta carpeta" android:textColor="@color/accent" android:textStyle="bold" android:textSize="14sp"
                android:background="@color/surface" android:layout_marginLeft="8dp"/>
        </LinearLayout>
        <TextView android:id="@+id/txtRutaActual" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="/" android:textColor="@color/muted" android:textSize="12sp" android:paddingBottom="6dp"/>
        <ListView android:id="@+id/listExplorar" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:cacheColorHint="#00000000" android:divider="#18FFFFFF" android:dividerHeight="1dp"/>
    </LinearLayout>

    <!-- Reproductor de video (pantalla completa) -->
    <FrameLayout
        android:id="@+id/paneVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone">
        <VideoView android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"/>
        <Button android:id="@+id/btnCerrarVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:text="Cerrar"
            android:textColor="#FFFFFF" android:textStyle="bold"
            android:background="#88000000"
            android:layout_margin="10dp"/>
    </FrameLayout>

</FrameLayout>

